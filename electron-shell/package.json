{
  "name": "gordon-shell",
  "version": "0.1.0",
  "description": "Gordon — desktop overlay + Kitchen dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "build": {
    "appId": "com.gordon.coach",
    "productName": "Gordon",
    "files": ["main.js", "preload.js", "overlay.html", "fonts.css", "scorer.js", "verdict-contract.js"],
    "extraResources": [
      { "from": "../design_handoff_gordon_overlay", "to": "design_handoff_gordon_overlay" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
